LEONARDO_API_KEY=
LEONARDO_API_BASE_URL=https://cloud.leonardo.ai/api/rest
LEONARDO_VIDEO_MODEL=hailuo-2_3-fast
LEONARDO_FALLBACK_VIDEO_MODEL=hailuo-2_3
LEONARDO_VIDEO_MODE=RESOLUTION_768
LEONARDO_VIDEO_WIDTH=1376
LEONARDO_VIDEO_HEIGHT=768
LEONARDO_VIDEO_DURATION=6
LEONARDO_GENERATE_AUDIO=false
LEONARDO_PUBLIC=false

# Optional Hailuo styles. Leave empty for the lowest-risk MVP request.
LEONARDO_STYLE_IDS=
LEONARDO_MAX_UPLOAD_DIMENSION=2048
LEONARDO_UPLOAD_ASPECT_RATIO=16:9

# ─── Gemini API (generate_story_video.py TTS 사용) ─────────────
# Google AI Studio에서 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# TTS 모델 및 음성 (변경 필요 시만 설정, 기본값은 코드에 정의)
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# GEMINI_TTS_VOICE=Kore

# Optional: override if you have a preferred ffmpeg binary.
FFMPEG_BIN=
